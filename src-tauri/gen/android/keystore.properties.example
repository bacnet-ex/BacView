# Copy to keystore.properties (gitignored) and fill in real values:
#
#   cp keystore.properties.example keystore.properties
#   ./scripts/android_create_keystore.sh   # optional: create a local JKS
#
# Or set the BACVIEW_ANDROID_* environment variables instead (CI).

storeFile=bacview-release.jks
storePassword=change-me
keyAlias=bacview
keyPassword=change-me
